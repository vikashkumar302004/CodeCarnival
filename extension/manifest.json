{
  "manifest_version": 3,
  "name": "CodeCarnival",
  "version": "1.2.0",
  "description": "Beautiful LeetCode themes and a celebration for every Accepted.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://leetcode.com/*", "https://*.leetcode.com/*"],
  "action": {
    "default_title": "CodeCarnival",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "studio.html",
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*", "https://*.leetcode.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/neon-web-city.png", "assets/sakura-ronin.png", "assets/pixel-dungeon.png"],
      "matches": ["https://leetcode.com/*", "https://*.leetcode.com/*"]
    }
  ]
}
